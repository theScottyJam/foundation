// -- The program -- //

def sum {
  def left { isInput(target=self) }
  def right { isInput(target=self) }
  def result { isOutput(target=self) }

  def $left { isVar(target=self) }
  def $right { isVar(target=self) }
  def $result { isVar(target=self) }
  def sumDef { isFnSignature(target=self) }

  sum(left=$left, right=$right, result=$result, global:relationshipId=sumDef)
  then(
    left=is(left=$right, right=0)->result,
    right=is(left=$result, right=$left)->result,
    result=true,
  )
  /*
  then(
    left=not(
      operand=is(left=$left, right=0)->result
    )->result,
    right=is(
      left=$result,
      right=Natural:next(
        target=sum(
          left=$left,
          right=Natural:previous(target=$right)->previous
        )->result,
      )->next
    )->result,
    result=true,
  )
  */
}

// programExit(value=sum(left=3, right=2)->result)
programExit(value=sum(left=3, right=0)->result)
